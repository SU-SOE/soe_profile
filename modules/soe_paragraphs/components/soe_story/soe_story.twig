{%- set attributes = attributes.addClass(['su-stories-paragraph']) -%}

<div{{ attributes }}>
  <div class="su-stories-paragraph__content">

    <div class="su-stories-paragraph__photo border-color-{{ border_color|default("default") }}">
      {{ image }}
    </div>

    <div class="su-stories-paragraph__details">
      <{{ header_tag }}>
      {{ name }}
    </{{ header_tag }}>

    {% if title %}
      <div>{{ title }}</div>
      {% endif %}

      {%- if quote -%}
        <div class="su-stories-paragraph__quote">
          <p>&ldquo;{{ quote }}... &rdquo;</p>
        </div>
      {%- endif -%}

      {% if story_link_url and story_link_text %}
        <a href="{{ story_link_url }}">{{ story_link_text }}</a>
      {% endif %}
    </div>
  </div>

  {%- if cta_link_url and cta_link_title -%}
    <div class="su-stories-paragraph__cta-region">
      <a href="{{ cta_link_url }}">{{ cta_link_title }}</a>
    </div>
  {%- endif -%}
</div>
